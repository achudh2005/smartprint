# ============================================================
# SmartPrint – Environment Variables Example
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to version control.
# ============================================================

# ----- Database -----
DATABASE_URL="mysql://root:yourpassword@localhost:3306/smartprint"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartprint
DB_USER=root
DB_PASSWORD=yourpassword

# ----- Backend -----
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ----- JWT -----
JWT_SECRET=change_this_to_a_long_random_secret_at_least_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=another_long_random_secret_for_refresh_tokens
JWT_REFRESH_EXPIRES_IN=30d

# ----- Argon2 / Password Hashing -----
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# ----- CORS -----
ALLOWED_ORIGINS=http://localhost:5173

# ----- Rate Limiting -----
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
AUTH_RATE_LIMIT_MAX=10

# ----- File Storage (Phase 2+) -----
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads
# STORAGE_BUCKET_NAME=
# STORAGE_REGION=
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=

# ----- Logging -----
LOG_LEVEL=debug
