# ============================================================
# SmartPrint – Frontend Environment Variables
# Copy to .env or .env.production
# ============================================================

# API Base URL (leave blank in dev to use Vite proxy /api/v1, or set to your public backend URL in production)
# Example: https://api.smartprint.yourdomain.com/api/v1
VITE_API_URL=

# Razorpay Client-Side Key ID (optional, for online customer checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_placeholder
