# ============================================================
# SmartPrint – Backend Environment Variables
# Copy to .env and configure for your environment
# ============================================================

# Database (MySQL 8.0 / Cloud SQL)
DATABASE_URL="mysql://root:password@localhost:3306/smartprint"
DB_HOST=localhost
DB_PORT=3306
DB_NAME=smartprint
DB_USER=root
DB_PASSWORD=password

# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# JWT Secrets (generate strong random secrets for production)
JWT_SECRET=smartprint_super_secret_jwt_key_production_replace_this_with_64_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=smartprint_refresh_secret_key_production_replace_this_with_64_chars
JWT_REFRESH_EXPIRES_IN=30d

# Argon2 Hashing
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

# CORS (comma-separated allowed origins)
ALLOWED_ORIGINS=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10000
AUTH_RATE_LIMIT_MAX=100

# File Storage & At-Rest Encryption
STORAGE_PROVIDER=local
STORAGE_LOCAL_PATH=./uploads

# AES-256-GCM Envelope Master Key for at-rest encryption of customer documents (ID proofs, PDFs, etc.)
# Must be exactly 32 bytes (256 bits) encoded as base64.
# Generate with: openssl rand -base64 32
AES_MASTER_KEY=

# Razorpay (optional for online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Logging
LOG_LEVEL=debug
